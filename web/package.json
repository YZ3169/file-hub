{
  "name": "file-hub-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "file-hub 上传工作台（Vue 3 + Vite）",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vite": "^7.3.8",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.2"
  }
}
